# Compile-time configuration, applied by Flutter's --dart-define-from-file.
#
#   cp .env.example .env
#   flutter run --dart-define-from-file=.env
#
# The root Makefile applies this file for you: `make run`, `make build-linux`,
# `make build-apk` (see `make help`).
#
# Every entry becomes a --dart-define, so it is fixed at compile time. This
# file is gitignored: it is per-machine, and may hold secrets one day.
#
# Release packaging does not read this file. The production URL is pinned per
# job in distribute_options.yaml, and a release build refuses a cleartext
# http:// URL outright.
#
# Commented out: the app's own default is the local podman-compose stack from
# the infra repo (http://localhost:8000/v1), so you only need this file when
# pointing a build somewhere else.

# API_BASE_URL=https://api.example.com/v1

# Public site where accounts are created. The login screen shows a "Create
# account" button that opens it in the system browser, and prints the URL
# underneath. Leave it unset to hide that row entirely.
# WEBSITE_URL=https://example.com

# Optional SPKI pin(s) for the API certificate: comma-separated base64 SHA-256
# of the server cert's SubjectPublicKeyInfo, which survives certificate
# renewal while the key is reused. Compute with:
#   openssl x509 -in cert.pem -pubkey -noout \
#     | openssl pkey -pubin -outform DER | openssl dgst -sha256 -binary | base64
# TLS_PIN_SPKI_SHA256=

# iOS/macOS only: the Network Extension target id and the App Group shared by
# the app and that extension. The app fails fast naming whichever is missing.
# VPN_PROVIDER_BUNDLE_ID=com.example.example.tunnel
# VPN_APP_GROUP=group.com.example.example

# Optional platform label override (e.g. android) for diagnostics.
# VPN_PLATFORM=android
