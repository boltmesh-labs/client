[Unit]
Description=BoltMesh VPN privileged helper socket
Documentation=https://github.com/boltmesh-labs/vpn-core
PartOf=boltmeshd.service
Before=boltmeshd.service

[Socket]
ListenStream=/run/boltmesh/boltmeshd.sock
SocketUser=root
SocketGroup=boltmesh
SocketMode=0660
# DirectoryMode creates the parent before socket activation. The service owns
# the directory lifetime so its config survives the stop sequence; this unit
# removes only the socket node.
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
