# ---> Flutter
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
dist/
.dart_tool/
.flutter_build/
.idea/
.vscode/*

# ---> Dart
*.dart.js
*.js.deps
*.js.map

# ---> OS
.DS_Store
Thumbs.db
# Widget Preview related
.widget_preview/

# ---> Code signing
# Never commit certificates/keys (Windows Authenticode; Android keystores).
*.pfx
*.p12
*.jks
*.keystore

boltmeshd/bin
coverage

# Python bytecode from the stream-transport end-to-end harness (tool/stream_e2e).
# Its self-tests are run directly, so the cache is a local artifact.
__pycache__/
*.pyc

# ---> Local build configuration
# Compile-time defines read by `flutter --dart-define-from-file=.env`;
# commit .env.example instead. The wildcard also covers credential-bearing
# variants (.env.e2e holds staging API user/password for device runs), so
# none of them can be committed by an `add -A`.
.env*
!.env.example
