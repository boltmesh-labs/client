<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Packet Tunnel provider host app. Still requires the
		NetworkExtension capability + a tunnel extension target in Xcode
		(signed with a provisioning profile that includes this
		entitlement); see README "iOS/macOS". -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
</dict>
</plist>
