# The Gradle wrapper is tracked, unlike the Flutter template: the CI
# `validate-android` job runs ./gradlew without a prior `flutter build`,
# which is what normally injects these files. They are byte-identical to
# the Flutter SDK's gradle_wrapper artifact, so flutter never overrides them.
/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
